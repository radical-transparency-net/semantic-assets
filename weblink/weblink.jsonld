{
  "@context": {
    "rtwl": "https://w3id.org/rt/ns/weblink#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "vann": "http://purl.org/vocab/vann/",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@graph": [
    {
      "@id": "https://w3id.org/rt/ns/weblink",
      "@type": "owl:Ontology",
      "dcterms:title": {
        "@value": "Radical Transparency Web Linking Vocabulary (rtwl)",
        "@language": "en"
      },
      "dcterms:description": {
        "@value": "A lightweight RDF reification vocabulary for factually recording observed RFC 8288 Web Links and RFC 9264 Linksets—capturing anchor, link relation, target URI, and arbitrary target attributes—without inventing non-existent terms under existing W3C namespaces.",
        "@language": "en"
      },
      "dcterms:creator": {
        "@id": "https://orcid.org/0000-0002-9648-6484"
      },
      "dcterms:contributor": {
        "@id": "https://orcid.org/0000-0001-6387-5988"
      },
      "dcterms:publisher": {
        "@id": "https://radical-transparency.net/"
      },
      "dcterms:created": {
        "@value": "2026-11-25",
        "@type": "xsd:date"
      },
      "dcterms:modified": {
        "@value": "2026-11-25",
        "@type": "xsd:date"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "owl:versionInfo": "0.1.0-draft",
      "vann:preferredNamespacePrefix": "rtwl",
      "vann:preferredNamespaceUri": "https://w3id.org/rt/ns/weblink#",
      "rdfs:seeAlso": [
        { "@id": "https://www.rfc-editor.org/info/rfc8288" },
        { "@id": "https://www.rfc-editor.org/info/rfc9264" },
        { "@id": "https://radical-transparency-net.github.io/spec-linkset-usage-patterns/" }
      ]
    },
    {
      "@id": "rtwl:WebLink",
      "@type": ["rdfs:Class", "owl:Class"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "Web Link", "@language": "en" },
      "rdfs:comment": {
        "@value": "A reified representation of an observed typed web link as defined by RFC 8288 (anchor, link relation, target URI, and optional target attributes).",
        "@language": "en"
      },
      "skos:scopeNote": {
        "@value": "Use rtwl:WebLink when preserving target attributes (such as type, profile, hreflang, or title) or when decoupling raw link observation from downstream semantic entailments (e.g., dcterms:conformsTo).",
        "@language": "en"
      }
    },
    {
      "@id": "rtwl:TargetAttribute",
      "@type": ["rdfs:Class", "owl:Class"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "Target Attribute", "@language": "en" },
      "rdfs:comment": {
        "@value": "A key-value attribute qualifying a reified rtwl:WebLink target, corresponding to an RFC 8288 Section 3.4 link-param (e.g., type, profile, hreflang, media, title).",
        "@language": "en"
      }
    },
    {
      "@id": "rtwl:Linkset",
      "@type": ["rdfs:Class", "owl:Class"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "Linkset", "@language": "en" },
      "rdfs:comment": {
        "@value": "A collection of reified rtwl:WebLink assertions observed together from a single HTTP response, Linkset document (RFC 9264), HTML document, or XML Sitemap.",
        "@language": "en"
      },
      "skos:editorialNote": {
        "@value": "Draft extension candidate for review: enables attaching observation provenance (e.g., dcterms:source, prov:generatedAtTime) at the set level rather than repeating it on every rtwl:WebLink.",
        "@language": "en"
      }
    },
    {
      "@id": "rtwl:anchor",
      "@type": ["rdf:Property", "owl:ObjectProperty"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "anchor", "@language": "en" },
      "rdfs:comment": {
        "@value": "The link context / anchor resource (RFC 8288 Section 3.2) from which the web link originates.",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:WebLink" },
      "rdfs:range": { "@id": "rdfs:Resource" }
    },
    {
      "@id": "rtwl:href",
      "@type": ["rdf:Property", "owl:ObjectProperty"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "href", "@language": "en" },
      "rdfs:comment": {
        "@value": "The target resource IRI (RFC 8288 Section 3.1) to which the web link points.",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:WebLink" },
      "rdfs:range": { "@id": "rdfs:Resource" }
    },
    {
      "@id": "rtwl:rel",
      "@type": "rdf:Property",
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "relation type", "@language": "en" },
      "rdfs:comment": {
        "@value": "The link relation type (RFC 8288 Section 2.1): either an IANA-registered relation token literal (e.g., \"alternate\", \"profile\") or an extension relation IRI (e.g., <http://schema.org/hasPart>).",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:WebLink" },
      "skos:editorialNote": {
        "@value": "Design review point: intentionally typed as rdf:Property (RDFS) rather than owl:ObjectProperty or owl:DatatypeProperty because RFC 8288 permits both short string tokens and full extension IRIs.",
        "@language": "en"
      }
    },
    {
      "@id": "rtwl:attribute",
      "@type": ["rdf:Property", "owl:ObjectProperty"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "target attribute", "@language": "en" },
      "rdfs:comment": {
        "@value": "Links a reified rtwl:WebLink to an rtwl:TargetAttribute key-value node qualifying its target.",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:WebLink" },
      "rdfs:range": { "@id": "rtwl:TargetAttribute" }
    },
    {
      "@id": "rtwl:key",
      "@type": ["rdf:Property", "owl:DatatypeProperty"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "attribute key", "@language": "en" },
      "rdfs:comment": {
        "@value": "The parameter name of a target attribute (e.g., \"type\", \"profile\", \"hreflang\", \"title\").",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:TargetAttribute" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "rtwl:value",
      "@type": "rdf:Property",
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "attribute value", "@language": "en" },
      "rdfs:comment": {
        "@value": "The value of a target attribute: a literal (such as a media type \"text/turtle\" or language-tagged title) or a resource IRI (such as a profile URI).",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:TargetAttribute" },
      "skos:editorialNote": {
        "@value": "Design review point: intentionally typed as rdf:Property (RDFS) rather than owl:DatatypeProperty/owl:ObjectProperty so attributes like \"profile\" can hold an IRI directly while \"type\" holds an xsd:string literal.",
        "@language": "en"
      }
    },
    {
      "@id": "rtwl:link",
      "@type": ["rdf:Property", "owl:ObjectProperty"],
      "rdfs:isDefinedBy": { "@id": "https://w3id.org/rt/ns/weblink" },
      "rdfs:label": { "@value": "contains link", "@language": "en" },
      "rdfs:comment": {
        "@value": "Associates a rtwl:Linkset observation container with one of its member rtwl:WebLink instances.",
        "@language": "en"
      },
      "rdfs:domain": { "@id": "rtwl:Linkset" },
      "rdfs:range": { "@id": "rtwl:WebLink" },
      "skos:editorialNote": {
        "@value": "Draft extension candidate for review alongside rtwl:Linkset.",
        "@language": "en"
      }
    }
  ]
}
